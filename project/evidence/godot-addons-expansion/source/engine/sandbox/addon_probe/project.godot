; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AIGameEngine Addon Compatibility Probe"
run/main_scene="res://probe.tscn"
config/features=PackedStringArray("4.7")
run/main_scene.addon_systems="res://systems/systems.tscn"

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/puzzle_dependencies/plugin.cfg", "res://addons/probe_editor/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://systems/terminal.dialogue")

[puzzle_dependencies]

current_board_id="bank_starter"
boards={
"bank_starter": {
"connections": [{
&"from": &"card",
&"to": &"power"
}, {
&"from": &"power",
&"to": &"exit"
}],
"id": "bank_starter",
"label": "银行谜题结构示例（待原作核对）",
"scroll_offset": Vector2(-50, -37),
"things": [{
&"id": &"card",
&"position_offset": Vector2(40, 80),
&"size": Vector2(190, 100),
&"text": "找到门卡
示例条件",
&"type": 1
}, {
&"id": &"power",
&"position_offset": Vector2(330, 80),
&"size": Vector2(190, 100),
&"text": "检查供电
示例操作",
&"type": 2
}, {
&"id": &"exit",
&"position_offset": Vector2(620, 80),
&"size": Vector2(190, 100),
&"text": "继续探索
示例结果",
&"type": 3
}],
"zoom": 1.0
}
}
types={
0: {
&"color": Color(0, 0, 0, 1),
&"id": 0,
&"label": "Type 1"
},
1: {
&"color": Color(1, 0.47058824, 0.41960785, 1),
&"id": 1,
&"label": "Type 2"
},
2: {
&"color": Color(0.7411765, 0.5764706, 0.9764706, 1),
&"id": 2,
&"label": "Type 3"
},
3: {
&"color": Color(0.4509804, 0.9490196, 0.5019608, 1),
&"id": 3,
&"label": "Type 4"
},
4: {
&"color": Color(1, 0.87058824, 0.4, 1),
&"id": 4,
&"label": "Type 5"
}
}
minimap_enabled=true
minimap_size=Vector2(200, 150)
snapping_enabled=true
snapping_distance=20

[rendering]

renderer/rendering_method="gl_compatibility"
